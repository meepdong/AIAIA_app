# Variable names only. Copy to apps/mobile/.env.local and fill in. Never commit real values.
# Clients see only the Supabase URL and the publishable (anon) key; every other secret lives
# in Supabase function secrets or GitHub encrypted secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# development | staging | production (sets the app name and Android package)
APP_VARIANT=development

# Dev only: force the auth-gate stub into a state
# (loading | signed_out | no_profile | pending | blocked | adult_consent | active)
EXPO_PUBLIC_MOCK_SESSION=
